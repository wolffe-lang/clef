#!/usr/bin/env python3
"""Compile and execute logic tests, independently of wolf test's runner."""
import pathlib
import subprocess
root = pathlib.Path(__file__).resolve().parents[1]
wolf = root / '.wolf-bin/wolf/wolf-0.2.35-x86_64-unknown-linux-gnu/wolf'
files = sorted((root / 'src').glob('*_test.lu'))
assert files
for source in files:
    binary = root / 'target' / ('native-' + source.stem)
    subprocess.run([str(wolf),'build','--deny-warnings',str(source),'-o',str(binary)],check=True)
    subprocess.run([str(binary)],check=True)
print(f'native logic: {len(files)} compiled test programs passed')
