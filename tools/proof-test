#!/usr/bin/env python3
import json,pathlib,subprocess,sys
from elf import ELF,differences
ROOT=pathlib.Path(__file__).resolve().parents[1];out=ROOT/'target/evidence/proof';out.mkdir(parents=True,exist_ok=True)
clef=ROOT/'target/clef';rows=[]
probes={'mov':['movq $4096, %rsp','movq $-2147483648, %r15','movq $2147483647, %rax'],
'push':['push %rbp','push %r12'],'pop':['pop %r15','pop %rax'],
'call':['call .+5','call .-1'],'ret':['ret'],
'jmp':['jmp .','jmp .+129','jmp .-126'],
'lea':['lea 8(%rsi,%rdi,8), %rdx','lea (%rsp), %r8','lea (%rbp), %rax','lea 128(%r13,%r12,4), %r15','lea -129(%rax), %r9'],
'syscall':['syscall'],'hlt':['hlt'],'cmp':['cmpq $1, %r8','cmpq $-128, %rax','cmpq $127, %r15']}
for name,lines in {'empty':[''],**probes}.items():
    for i,line in enumerate(lines):
        key=f'{name}-{i}';src=out/(key+'.S');src.write_text(line+'\n')
        actual=out/(key+'.o');expected=out/(key+'.gas.o')
        subprocess.run([str(clef),'--64','-c',str(src),'-o',str(actual)],check=True)
        subprocess.run(['as','--64',str(src),'-o',str(expected)],check=True)
        diff=subprocess.run([str(ROOT/'tools/differ'),str(expected),str(actual)],capture_output=True,text=True)
        (out/(key+'.diff.json')).write_text(diff.stdout)
        assert diff.returncode==0,(key,diff.stdout)
        if name=='empty':
            a,b=ELF(actual),ELF(expected)
            # Every section field except name string index and file offset is equal.
            assert [(n,s[1:4]+s[5:]) for n,s in a.sections]==[(n,s[1:4]+s[5:]) for n,s in b.sections]
        again=out/(key+'.again.o');subprocess.run([str(clef),str(src),'-o',str(again)],check=True)
        assert again.read_bytes()==actual.read_bytes(),'nondeterministic output'
        rows.append({'name':key,'source':line,'text':next(s[-1] for s in ELF(actual).normalized()['sections'] if s[0]=='.text'),'equal':True})
for i,line in enumerate(['bogus %rax','movq $2147483648,%rax','movq $1,%eax','cmpq $128,%rax','jmp .+130','lea (%rax,%rsp,2),%rax','.unknown','ret %rax','movq $0x8000000000000000,%rax']):
    src=out/f'refuse-{i}.S';src.write_text(line+'\n');dest=out/f'refuse-{i}.o';dest.write_bytes(b'unchanged')
    p=subprocess.run([str(clef),str(src),'-o',str(dest)],capture_output=True,text=True)
    assert p.returncode==1 and p.stderr and dest.read_bytes()==b'unchanged',(line,p.returncode,p.stderr)
for argv in [[],['--bad'],['-o'],['a.S','b.S'],['-o','a.S','a.S']]:
    assert subprocess.run([str(clef)]+argv,capture_output=True).returncode==2
# Tie observations are oracle-only: clef does not pretend these extra forms are implemented.
ties={}
for name,line in {'mov-zero':'movq $0,%rax','movabs-zero':'movabsq $0,%rax','cmp-imm8':'cmpq $1,%rax','cmp-wide':'cmpq $128,%rax','mov-reg':'movq %rcx,%rax','lea-zero-base5':'lea (%rbp),%rax','cmp-forward-expression':'cmpq $(.Lend-.Lbegin),%rax\n.Lbegin: .zero 23\n.Lend:','cmp-known-expression':'.Lbegin: .zero 23\n.Lend:\ncmpq $(.Lend-.Lbegin),%rax'}.items():
    src=out/(name+'.S');src.write_text(line+'\n');obj=out/(name+'.o');subprocess.run(['as','--64',str(src),'-o',str(obj)],check=True)
    ties[name]={'source':line,'text':next(s[-1] for s in ELF(obj).normalized()['sections'] if s[0]=='.text')}
result={'proof_rows':rows,'oracle_ties':ties,'refusals':9,'usage_refusals':5}
(out/'summary.json').write_text(json.dumps(result,indent=2)+'\n')
print(f'proof: {len(rows)} exact objects, ten mnemonics, determinism, empty structure, 14 refusal rows pass')
