#!/usr/bin/env python3
"""Compare the Wolf parser against every pinned source statement and operand site."""
import json
import pathlib
import subprocess

ROOT = pathlib.Path(__file__).resolve().parents[1]
probe = ROOT / 'target/dialect-cli'
census = json.loads((ROOT / 'census/org-asm.json').read_text())
rows = sites = 0
for file in census['files']:
    if file['architecture'] != 'x86_64':
        continue
    path = ROOT / 'census/sources' / file['path']
    p = subprocess.run([str(probe), 'head', str(path)], capture_output=True, text=True, check=True)
    got = p.stdout.splitlines()
    expected = []
    for row in file['statements']:
        # Source census preserves whitespace within each operand; compare normalized pieces below.
        expected.append((str(row['line']), row.get('name', ''), '|'.join(row['labels']), '|'.join(row.get('prefixes', []))))
    actual = [tuple(line.split('\t')[:4]) for line in got]
    assert actual == expected, (file['path'], next(((a,b) for a,b in zip(actual,expected) if a != b), ('length',len(actual),len(expected))))
    rows += len(got)
    # Files without macro placeholders also pass the complete statement parser.
    if not file['macros'] and not any(row.get('name') == '.irp' for row in file['statements']):
        subprocess.run([str(probe), 'statement', str(path)], check=True, stdout=subprocess.DEVNULL)
# Exercise each distinct concrete operand in every instruction site, not only the first examples.
seen = set()
for file in census['files']:
    if file['architecture'] != 'x86_64':
        continue
    for row in file['statements']:
        if row.get('kind') != 'instruction':
            continue
        for op in row['operands']:
            # Derive spellings from the structured census, preserving expressions verbatim.
            indirect = '*' if op['indirect'] else ''
            kind = op['kind']
            if kind == 'memory':
                text = op['displacement']['text'] + '(' + op['base']
                if op['index']:
                    text += ',' + op['index'] + ',' + op['scale']
                text += ')'
            elif kind == 'immediate':
                text = '$' + op['expression']['text']
            elif 'register' in op:
                text = op['register']
            else:
                text = op['expression']['text']
            text = indirect + text.replace('\\n', '0').replace('\\v', '0')
            sites += 1
            if text in seen:
                continue
            seen.add(text)
            p = subprocess.run([str(probe), 'operand', text], capture_output=True, text=True)
            assert p.returncode == 0, (file['path'], row['line'], text, p.stderr)
            actual_kind = p.stdout.split('\t')[0]
            expected_kind = 'register' if 'register' in op else kind
            assert actual_kind == expected_kind, (text, actual_kind, expected_kind)
print(f'dialect: 43 x86-64 files, {rows} statements, {sites} operand sites, {len(seen)} distinct operand spellings; AArch64 deferred by name')
