#!/usr/bin/env python3
import hashlib,pathlib,shutil,subprocess,tomllib
ROOT=pathlib.Path(__file__).resolve().parents[1]
pins=tomllib.loads((ROOT/'wolf-toolchain.toml').read_text())
out=ROOT/'.wolf-bin';out.mkdir(exist_ok=True)
for name,p in pins.items():
    base=f'{name}-{p["version"]}-x86_64-unknown-linux-gnu'
    archive=out/(base+'.tar.gz')
    if not archive.exists():
        subprocess.run(['curl','-fsSL','--retry','3',f'https://github.com/{p["repo"]}/releases/download/v{p["version"]}/{base}.tar.gz','-o',str(archive)],check=True)
    for _ in range(2):
        assert hashlib.sha256(archive.read_bytes()).hexdigest()==p['sha256'], f'{name}: archive digest mismatch'
    stage=out/name
    # Cached extracted binaries are not an integrity boundary: always restage.
    if stage.exists(): shutil.rmtree(stage)
    stage.mkdir()
    subprocess.run(['tar','-xzf',str(archive),'-C',str(stage)],check=True)
    print(f'{name}: {p["sha256"]} verified twice')
