#!/usr/bin/env python3
import json
import sys
from elf import ELF,differences

def main():
    if len(sys.argv)!=3:
        print('usage: differ A.o B.o',file=sys.stderr); return 2
    try: delta=differences(ELF(sys.argv[1]),ELF(sys.argv[2]))
    except (ValueError,OSError) as e:
        print('differ: invalid input: '+str(e),file=sys.stderr); return 2
    print(json.dumps({'equal':not delta,'differences':delta},sort_keys=True))
    return 1 if delta else 0
if __name__=='__main__': sys.exit(main())
