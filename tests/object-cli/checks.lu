use object

fn refused(
    sections: List[object.Section],
    symbols: List[object.Symbol],
    relocations: List[object.Relocation],
) -> bool {
    let _ = object.write(sections, symbols, relocations) else { return true }
    false
}

fn checks() -> int {
    // Every refusal is exercised inside Wolf, not inferred from a host assertion.
    for case in 0..47 {
        var sections = defaults()
        sections[0] = sec(".text", 1, 6, 1, 8, take zeros(8))
        var symbols = [sym("external", 1, 0, "UND", 0, 0, 0)]
        var relocations = [rel(".text", 0, 1, "external", 0)]
        match case {
            0 => { sections[0].name = "" },
            1 => { sections[0].name = "bad\0name" },
            2 => { sections[1].name = ".text" },
            3 => { sections[1].name = ".symtab" },
            4 => { sections[1].name = ".rela.text" },
            5 => { sections[1].name = "ABS" },
            6 => { sections[0].kind = 4 },
            7 => { sections[0].flags = 16 },
            8 => { sections[0].flags = -1 },
            9 => { sections[0].align = -1 },
            10 => { sections[0].align = 3 },
            11 => { sections[0].align = 9223372036854775807 },
            12 => { sections[0].size = -1 },
            13 => { sections[0].size = 9 },
            14 => { sections[0].kind = 8 },
            15 => { symbols[0].name = "" },
            16 => { symbols[0].name = "bad\0name" },
            17 => { (mut symbols).push(sym("external", 0, 0, "ABS", 0, 0, 0)) },
            18 => { symbols[0].binding = 3 },
            19 => { symbols[0].binding = -1 },
            20 => { symbols[0].kind = 6 },
            21 => { symbols[0].kind = -1 },
            22 => { symbols[0].visibility = 4 },
            23 => { symbols[0].visibility = -1 },
            24 => { symbols[0].size = -1 },
            25 => { symbols[0].section = ".absent" },
            26 => { symbols[0].value = 1 },
            27 => { symbols[0].binding = 0 },
            28 => { symbols[0].section = ".text"; symbols[0].value = -1 },
            29 => { symbols[0].kind = 3 },
            30 => { symbols[0] = sym("external", 0, 3, ".text", 0, 0, 0) },
            31 => { symbols[0] = sym(".text", 1, 3, ".text", 0, 0, 0) },
            32 => { relocations[0].section = ".absent" },
            33 => { relocations[0].symbol = "absent" },
            34 => { relocations[0].kind = 9 },
            35 => { relocations[0].offset = -1 },
            36 => { relocations[0].offset = 1 },
            37 => { relocations[0].offset = 9223372036854775807 },
            38 => { relocations[0].section = ".bss"; sections[2].size = 8 },
            39 => { sections[0].align = 67108864 },
            40 => { sections[0].size = 9223372036854775807 },
            41 => { sections[0].align = 4611686018427387904 },
            42 => { symbols[0] = sym(".text", 0, 3, ".text", 1, 0, 0) },
            43 => { symbols[0] = sym(".text", 0, 3, ".text", 0, 1, 0) },
            44 => { symbols[0] = sym(".text", 0, 3, ".text", 0, 0, 1) },
            45 => { sections[1].name = "UND" },
            46 => { relocations[0].kind = 0 },
            _ => {},
        }
        if !refused(sections, symbols, relocations) {
            eprint("accepted invalid object case {case}")
            return 1
        }
    }
    var huge = defaults()
    huge[2].size = 9223372036854775807
    huge[2].align = 4611686018427387904
    let small = object.write(huge, [], []) else {
        eprint("NOBITS wrongly charged to file budget")
        return 1
    }
    if small.len > 1024 { return 1 }
    var sections = defaults()
    sections[0] = sec(".text", 1, 6, 0, 8, take zeros(8))
    let symbols = [sym("bottom", 0, 0, "ABS", -9223372036854775807 - 1, 0, 0)]
    let relocations = [rel(".text", 0, 1, "bottom", -9223372036854775807 - 1)]
    let a = object.write(sections, symbols, relocations) else { return 1 }
    let b = object.write(sections, symbols, relocations) else { return 1 }
    if a.len != b.len { return 1 }
    for i in 0..a.len {
        if a[i] != b[i] { return 1 }
    }
    // No caller mutation, and no implicit default sections or stack note.
    if sections[0].align != 0 || symbols[0].name != "bottom" { return 1 }
    let minimal = object.write([], [], []) else { return 1 }
    if minimal[60] != 2 as byte { return 1 }
    print(
        "47 malformed objects refused; NOBITS budget, signed extremes, zero alignment, determinism, no mutation: pass",
    )
    0
}
