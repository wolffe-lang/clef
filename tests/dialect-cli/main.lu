use dialect
use lex

fn joined(xs: List[str]) -> str {
    var s = ""
    for i in 0..xs.len {
        if i > 0 { s += "|" }
        s += xs[i]
    }
    s
}

fn main() -> int {
    let args = env_args()
    if args.len != 2 { return 2 }
    if args[0] == "operand" {
        let op = dialect.operand(args[1]) else { return 1 }
        print(
            "{op.kind}\t{op.reg.family}\t{op.reg.bits}\t{op.base.name}\t{op.index.name}\t{op.scale}\t{op.displacement}\t{op.indirect}",
        )
        return 0
    }
    let bytes = fs_read_bytes(args[1]) else { return 1 }
    let text = str_from_utf8(bytes) else { return 1 }
    let rows = lex.source(text, args[1]) else |e| { eprint("{e}"); return 1 }
    for row in rows {
        let node = if args[0] == "head" {
            dialect.head(row) else |e| { eprint("{e}"); return 1 }
        } else {
            dialect.statement(row) else |e| { eprint("{e}"); return 1 }
        }
        print(
            "{row.origin.line}\t{node.name}\t{joined(node.labels)}\t{joined(node.prefixes)}\t{joined(node.arguments)}",
        )
    }
    0
}
