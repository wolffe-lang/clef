use dialect
use eval
use expand
use lex

fn joined(xs: List[str]) -> str {
    var s = ""
    for i in 0..xs.len {
        if i > 0 { s += "|" }
        s += xs[i]
    }
    s
}

fn main() -> int {
    let args = env_args()
    if args.len != 2 { return 2 }
    if args[0] == "expression" {
        let value = eval.evaluate(args[1], Map[str, eval.Value](), eval.absolute(0)) else |e| {
            eprint("{e}")
            return 1
        }
        if value.section != "ABS" { eprint("unresolved_expression"); return 1 }
        print("{eval.bits(value.number)}")
        return 0
    }
    if args[0] == "operand" {
        let op = dialect.operand(args[1]) else { return 1 }
        print(
            "{op.kind}\t{op.reg.family}\t{op.reg.bits}\t{op.base.name}\t{op.index.name}\t{op.scale}\t{op.displacement}\t{op.indirect}",
        )
        return 0
    }
    let bytes = fs_read_bytes(args[1]) else { return 1 }
    let text = str_from_utf8(bytes) else { return 1 }
    if args[0] == "expand" {
        let rows = expand.source(text, args[1]) else |e| { eprint("{e}"); return 1 }
        for row in rows {
            let _ = dialect.statement(row) else |e| { eprint("{e}"); return 1 }
            print(expand.origin_comment(row.origin))
            print(row.text)
        }
        return 0
    }
    let rows = lex.source(text, args[1]) else |e| { eprint("{e}"); return 1 }
    for row in rows {
        let node = if args[0] == "head" {
            dialect.head(row) else |e| { eprint("{e}"); return 1 }
        } else {
            dialect.statement(row) else |e| { eprint("{e}"); return 1 }
        }
        print(
            "{row.origin.line}\t{node.name}\t{joined(node.labels)}\t{joined(node.prefixes)}\t{joined(node.arguments)}",
        )
    }
    0
}
