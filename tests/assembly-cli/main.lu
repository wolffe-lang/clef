use assembly

fn main() -> int {
    let args = env_args()
    if args.len != 2 { return 2 }
    let bytes = fs_read_bytes(args[0]) else { return 2 }
    let text = str_from_utf8(bytes) else { return 2 }
    let result = assembly.assemble(text, args[0]) else |e| { eprint("{e}"); return 1 }
    if args[1] == "--expand" {
        for line in result.expanded { print(line) }
        return 0
    }
    let fd = fs_open_mode(args[1], 1) else { return 2 }
    defer fs_close(fd) else |_| {}
    fs_write_chunk(fd, result.bytes) else |_| { return 2 }
    print("passes {result.passes}")
    for form in result.forms { print(form) }
    0
}
