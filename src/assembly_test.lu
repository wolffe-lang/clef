//! member: false

use assembly

fn equal(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn main() -> int {
    let source = "start: movq $1,%rax\njmp 1f\n.byte 0\n1: ret\n.size start,.-start\n"
    let a = assembly.assemble(source, "one.S") else { return 1 }
    let b = assembly.assemble(source, "one.S") else { return 1 }
    assert(equal(a.bytes, b.bytes))
    assert(
        a.bytes[64] == 72 as byte &&
            a.bytes[71] == 235 as byte &&
            a.bytes[72] == 1 as byte &&
            a.bytes[74] == 195 as byte,
    )
    let macro = assembly.assemble(
        ".set k,2\n.macro M v\npushq $\\v\n.endm\nM k\n",
        "macro.S",
    ) else { return 1 }
    assert(macro.bytes[64] == 106 as byte && macro.bytes[65] == 2 as byte)
    for pair in [
        [".data\n.skip 3,90\n.align 8,7\n.byte 1\n", ".data\n.space 3,90\n.balign 8,7\n.byte 1\n"],
        [".data\n.byte 1\n.p2align 4,90,14\n", ".data\n.byte 1\n.balign 16,90,14\n"],
        [".bss\n.skip 3\n.align 16\n", ".bss\n.space 3\n.balign 16\n"],
    ] {
        let left = assembly.assemble(pair[0], "aliases.S") else { return 1 }
        let right = assembly.assemble(pair[1], "aliases.S") else { return 1 }
        assert(equal(left.bytes, right.bytes))
    }
    // clef#21: two adjacent forward jumps, each 126 bytes out, stay short (GNU as: eb 7e, eb 7e).
    let adjacent = assembly.assemble(
        "jmp .Lp1\njmp .Lp2\n.zero 124\n.Lp1:\n.zero 2\n.Lp2:\nret\n",
        "adjacent.S",
    ) else { return 1 }
    assert(
        adjacent.bytes[64] == 235 as byte &&
            adjacent.bytes[65] == 126 as byte &&
            adjacent.bytes[66] == 235 as byte &&
            adjacent.bytes[67] == 126 as byte,
    )
    // Both short and both long are consistent here; GNU as starts short and keeps both short.
    let spanning = assembly.assemble(
        "Y:\n.zero 63\njmp X\n.zero 60\njmp Y\n.zero 64\nX:\nret\n",
        "spanning.S",
    ) else { return 1 }
    assert(
        spanning.bytes[127] == 235 as byte &&
            spanning.bytes[128] == 126 as byte &&
            spanning.bytes[189] == 235 as byte &&
            spanning.bytes[190] == 129 as byte,
    )
    let note = assembly.assemble_options(source, "one.S", true) else { return 1 }
    assert(note.bytes.len > a.bytes.len)
    for bad in [".set A,B+1\n.set B,A+1\n", ".bss\n.byte 1\n", "jmp 8b\n"] {
        var refused = false
        let _ = assembly.assemble(bad, "bad.S") else {
            refused = true
            assembly.Result { bytes: [], expanded: [], forms: [], passes: 0 }
        }
        assert(refused)
    }
    print(
        "assembly: layout, mutually dependent jumps, numeric locals, set/macro values, deterministic ELF, provenance and refusals pass",
    )
    0
}
