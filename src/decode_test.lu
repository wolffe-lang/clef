//! member: false

use decode
use x86table

fn equal_bytes(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn main() -> int {
    let forms = x86table.load_all() else { return 1 }
    let idx = decode.index(forms)
    // 48 89 e5: MOV r/m64, r64 (SDM vol.2B 4.3 MOV, REX.W + 89 /r) spelled mov %rsp,%rbp.
    let a = decode.decode(idx, [72 as byte, 137 as byte, 229 as byte], 0, 64, 4096)
    assert(a.length == 3 && a.refusal.len == 0 && a.mnemonic == "mov")
    assert(a.operands.len == 2 && a.operands[0] == "%rsp" && a.operands[1] == "%rbp")
    assert(decode.text(a, 4096) == "1000:\tmov    %rsp,%rbp")
    // 66 90: XCHG AX, AX (the 16-bit 90+r row consumes the operand-size prefix); 90 alone is NOP.
    let b = decode.decode(idx, [102 as byte, 144 as byte], 0, 64, 0)
    assert(
        b.mnemonic == "xchg" && b.operands.len == 2 && b.operands[0] == "%ax" && b.words.len == 0,
    )
    let n = decode.decode(idx, [144 as byte], 0, 64, 0)
    assert(n.mnemonic == "nop" && n.operands.len == 0)
    // eb fe: JMP rel8 to itself; the target is absolute text, the round-trip source `.+0`.
    let bytes = [235 as byte, 254 as byte, 195 as byte]
    let j = decode.decode(idx, bytes, 0, 64, 4096)
    assert(j.mnemonic == "jmp" && j.operands[0] == "0x1000" && j.target == 4096)
    assert(decode.roundtrip(idx, bytes, j, 64) == "jmp .+0")
    let r = decode.decode(idx, bytes, 2, 64, 4096)
    assert(r.mnemonic == "ret" && r.offset == 2 && r.length == 1)
    // A reserved cell is one named byte, never a guess: 0F 0F.
    let bad = decode.decode(idx, [15 as byte, 15 as byte], 0, 64, 0)
    assert(bad.refusal == "invalid_opcode" && bad.length == 2)
    // The round-trip renderer escapes what it cannot force.
    assert(decode.roundtrip(idx, [15 as byte, 15 as byte], bad, 64).starts_with(".byte 0xf,0xf"))
    // An out-of-scope x87 escape consumes its whole ModRM form: d8 c1 (FADD ST(0),ST(1), SDM
    // vol.2D Table A-8) is two bytes, so the stream stays in step with objdump's.
    let x87 = decode.decode(idx, [216 as byte, 193 as byte, 195 as byte], 0, 64, 0)
    assert(x87.refusal == "out_of_scope:x87" && x87.length == 2)
    // Memory forms: 48 8b 44 24 08 is mov 0x8(%rsp),%rax (SIB, disp8); 8b 05 d8 ff ff ff is
    // RIP-relative with its target comment; 67 8b 00 is an address-size override (SDM 2A 2.2.1.3).
    let m = decode.decode(
        idx,
        [72 as byte, 139 as byte, 68 as byte, 36 as byte, 8 as byte],
        0,
        64,
        0,
    )
    assert(m.length == 5 && m.operands[0] == "0x8(%rsp)" && m.operands[1] == "%rax")
    let rip = decode.decode(
        idx,
        [139 as byte, 5 as byte, 216 as byte, 255 as byte, 255 as byte, 255 as byte],
        0,
        64,
        4096,
    )
    assert(rip.operands[0] == "-0x28(%rip)" && rip.comment == "        # 0xfde")
    let a32 = decode.decode(idx, [103 as byte, 139 as byte, 0 as byte], 0, 64, 0)
    assert(a32.mnemonic == "mov" && a32.operands[0] == "(%eax)" && a32.words.len == 0)
    // .code32: 00 08 is add %cl,(%eax).
    let c32 = decode.decode(idx, [0 as byte, 8 as byte], 0, 32, 0)
    assert(c32.mnemonic == "add" && c32.operands[0] == "%cl" && c32.operands[1] == "(%eax)")
    // The round trip of a memory form and of a sign-extended immediate.
    assert(
        decode.roundtrip(
            idx,
            [72 as byte, 139 as byte, 68 as byte, 36 as byte, 8 as byte],
            m,
            64,
        ) ==
            "mov 0x8(%rsp),%rax",
    )
    let imm = decode.decode(idx, [72 as byte, 131 as byte, 228 as byte, 240 as byte], 0, 64, 0)
    assert(
        imm.mnemonic == "and" &&
            imm.operands[0] == "$0xfffffffffffffff0" &&
            imm.operands[1] == "%rsp",
    )
    assert(
        decode.roundtrip(idx, [72 as byte, 131 as byte, 228 as byte, 240 as byte], imm, 64) ==
            "and $0xfffffffffffffff0,%rsp",
    )
    // Determinism: the same bytes give the same text.
    let again = decode.decode(idx, [72 as byte, 137 as byte, 229 as byte], 0, 64, 4096)
    assert(decode.text(again, 4096) == decode.text(a, 4096))
    // SSE2 scalar double (SDM vol.2A 3.3 ADDSD, CVTSI2SD; vol.2B 4.3 MOVSD, MOVD/MOVQ), in the
    // pinned objdump's spelling: f2 0f 58 c1 is addsd %xmm1,%xmm0.
    let sd = decode.decode(idx, [242 as byte, 15 as byte, 88 as byte, 193 as byte], 0, 64, 0)
    assert(
        sd.refusal.len == 0 &&
            sd.mnemonic == "addsd" &&
            sd.operands[0] == "%xmm1" &&
            sd.operands[1] == "%xmm0",
    )
    // A memory source names its integer width in 64-bit code only: cvtsi2sdq, then cvtsi2sd.
    let cq = decode.decode(
        idx,
        [242 as byte, 72 as byte, 15 as byte, 42 as byte, 69 as byte, 240 as byte],
        0,
        64,
        0,
    )
    assert(cq.mnemonic == "cvtsi2sdq" && cq.operands[0] == "-0x10(%rbp)")
    let l32 = decode.decode(idx, [242 as byte, 15 as byte, 42 as byte, 0 as byte], 0, 32, 0)
    assert(l32.mnemonic == "cvtsi2sd" && l32.operands[0] == "(%eax)")
    // MOVSD's store form between registers round-trips through {store}.
    let st = [242 as byte, 15 as byte, 17 as byte, 193 as byte]
    let sdst = decode.decode(idx, st, 0, 64, 0)
    assert(
        sdst.mnemonic == "movsd" &&
            decode.roundtrip(idx, st, sdst, 64) == "{{store}} movsd %xmm0,%xmm1",
    )
    // 66 48 0f 7e c0 is movq %xmm0,%rax.
    let mq = [102 as byte, 72 as byte, 15 as byte, 126 as byte, 192 as byte]
    let bits = decode.decode(idx, mq, 0, 64, 0)
    assert(bits.mnemonic == "movq" && bits.operands[0] == "%xmm0" && bits.operands[1] == "%rax")
    assert(decode.roundtrip(idx, mq, bits, 64) == "movq %xmm0,%rax")
    // An unconsumed F3 before MOVSD's F2 is objdump's repz.
    let rz = decode.decode(
        idx,
        [243 as byte, 242 as byte, 15 as byte, 16 as byte, 193 as byte],
        0,
        64,
        0,
    )
    assert(rz.mnemonic == "movsd" && rz.words.len == 1 && rz.words[0] == "repz")
    // REX.X with SIB index 100 names %r12, so the bit is used and objdump prints no rex word:
    // f2 42 0f 59 04 e0 is mulsd (%rax,%r12,8),%xmm0; f2 43 0f 10 64 e5 08 is
    // movsd 0x8(%r13,%r12,8),%xmm4. Without a SIB, REX.X is unused: rex.X addsd %xmm1,%xmm0.
    let ix = decode.decode(
        idx,
        [242 as byte, 66 as byte, 15 as byte, 89 as byte, 4 as byte, 224 as byte],
        0,
        64,
        0,
    )
    assert(decode.text(ix, 0) == "0:\tmulsd  (%rax,%r12,8),%xmm0")
    let ixb = decode.decode(
        idx,
        [242 as byte, 67 as byte, 15 as byte, 16 as byte, 100 as byte, 229 as byte, 8 as byte],
        0,
        64,
        0,
    )
    assert(decode.text(ixb, 0) == "0:\tmovsd  0x8(%r13,%r12,8),%xmm4")
    let nx = decode.decode(
        idx,
        [242 as byte, 66 as byte, 15 as byte, 88 as byte, 193 as byte],
        0,
        64,
        0,
    )
    assert(decode.text(nx, 0) == "0:\trex.X addsd  %xmm1,%xmm0")
    // Cells these rows leave out stay out of scope: ADDSS (F3), ADDPS (no prefix), MOVQ's r/m64
    // memory form, and F3 after F2 (objdump reads MOVSS).
    for cell in [
        [243 as byte, 15 as byte, 88 as byte, 193 as byte],
        [15 as byte, 88 as byte, 193 as byte],
        [102 as byte, 72 as byte, 15 as byte, 126 as byte, 0 as byte],
        [242 as byte, 243 as byte, 15 as byte, 16 as byte, 193 as byte],
    ] {
        assert(decode.decode(idx, cell, 0, 64, 0).refusal == "out_of_scope:sse")
    }
    assert(equal_bytes([1 as byte], [1 as byte]))
    0
}
