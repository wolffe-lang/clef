// ELF gABI chapter 4: ELF header, sections, string table. ET_REL x86-64.
// A0 writes .text with no symbols or relocations; A1 extends this writer.
fn word(mut out: List[byte], value: int, count: int) {
    var n = value
    for _ in 0..count {
        (mut out).push((n & 255) as byte)
        n >>= 8
    }
}

fn section(mut out: List[byte], name: int, kind: int, flags: int, offset: int, size: int) {
    word(mut out, name, 4)
    word(mut out, kind, 4)
    word(mut out, flags, 8)
    word(mut out, 0, 8)
    word(mut out, offset, 8)
    word(mut out, size, 8)
    word(mut out, 0, 4)
    word(mut out, 0, 4)
    word(mut out, 1, 8)
    word(mut out, 0, 8)
}

/// Emit deterministic ELF64 ET_REL containing text and empty data/bss; no symbols or relocations.
pub fn object(text: List[byte]) -> List[byte] {
    let names = "\0.shstrtab\0.text\0.data\0.bss\0"
    let strings = 64 + text.len
    let sections = (strings + names.len + 7) / 8 * 8
    var out = List[byte]()
    for b in "\x7fELF".bytes() { (mut out).push(b) }
    for b in [2, 1, 1, 0] { (mut out).push(b as byte) }
    word(mut out, 0, 8)
    word(mut out, 1, 2)
    word(mut out, 62, 2)
    word(mut out, 1, 4)
    word(mut out, 0, 8)
    word(mut out, 0, 8)
    word(mut out, sections, 8)
    word(mut out, 0, 4)
    word(mut out, 64, 2)
    word(mut out, 0, 2)
    word(mut out, 0, 2)
    word(mut out, 64, 2)
    word(mut out, 5, 2)
    word(mut out, 4, 2)
    for b in text { (mut out).push(b) }
    for b in names.bytes() { (mut out).push(b) }
    while out.len < sections { (mut out).push(0 as byte) }
    for _ in 0..64 { (mut out).push(0 as byte) }
    section(mut out, 11, 1, 6, 64, text.len)
    section(mut out, 17, 1, 3, strings, 0)
    section(mut out, 23, 8, 3, strings, 0)
    section(mut out, 1, 3, 0, strings, names.len)
    out
}
