use dialect
use eval
use expand
use lex
use machine
use object
use x86table

struct Range {
    section: str,
    offset: int,
    size: int,
    origin: lex.Origin,
}

struct Pass {
    sections: List[object.Section],
    raw_tail: List[bool],
    current: int,
    mode: int,
    symbols: Map[str, eval.Value],
    sizes: Map[str, int],
    sets: Map[str, bool],
    set_values: List[eval.Value],
    dots: List[eval.Value],
    lengths: List[int],
    selected: List[List[bool]],
    relocations: List[object.Relocation],
    forms: List[str],
    ranges: List[Range],
}

/// Final deterministic object plus reviewable expansion and selected table identities.
pub struct Result {
    bytes: List[byte],
    expanded: List[str],
    forms: List[str],
    passes: int,
}

fn empty_section(name: str, kind: int, flags: int) -> object.Section {
    object.Section { name: name, kind: kind, flags: flags, align: 1, size: 0, data: [] }
}

fn symbol_value(symbols: Map[str, eval.Value], name: str) -> eval.Value {
    let v = symbols[name] else {
        return eval.Value { number: eval.number(0), section: "UND", name: name, known: false }
    }
    copy v
}

fn evaluate(
    text: str,
    symbols: Map[str, eval.Value],
    dot: eval.Value,
    origin: lex.Origin,
    final: bool,
) -> eval.Value ! Errors {
    eval.evaluate(text, symbols, dot) else |e| match e {
        unresolved_expression => {
            if final { return Assembly(failure(origin, "unresolved_expression {text}: GNU as §6")) }
            eval.Value { number: eval.number(0), section: "PENDING", name: text, known: false }
        },
        _ => { return Assembly(failure(origin, "{e} in {text}: GNU as §6")) },
    }
}

fn integer(value: eval.Value, origin: lex.Origin, final: bool) -> int ! Errors {
    if value.section != "ABS" {
        if !final && (value.section == "UND" || value.section == "PENDING") { return 0 }
        return Assembly(failure(origin, "absolute_expression_required: GNU as §6"))
    }
    eval.signed(value.number) else {
        return Assembly(failure(origin, "expression_overflow: GNU as §6"))
    }
}

fn signed_bits(n: eval.Number) -> int {
    let bits = eval.bits(n)
    if bits >= 9223372036854775808 { return -1 - !bits as int }
    bits as int
}

fn add_bytes(mut pass: Pass, bytes: List[byte], origin: lex.Origin) -> () ! Errors {
    let i = pass.current
    if bytes.len > 67108864 || pass.sections[i].size > 2147483647 - bytes.len {
        return Assembly(failure(origin, "section_size_limit: ELF gABI Sections"))
    }
    if pass.sections[i].kind == 8 {
        for b in bytes {
            if b != 0 as byte {
                return Assembly(failure(origin, "nonzero_nobits_data: ELF gABI Sections"))
            }
        }
    } else {
        if pass.sections[i].data.len > 67108864 - bytes.len {
            return Assembly(failure(origin, "object_size_limit: ELF gABI Sections"))
        }
        for b in bytes { (mut pass.sections[i].data).push(b) }
    }
    pass.sections[i].size += bytes.len
}

fn fill(mut pass: Pass, count: int, byte_value: int, origin: lex.Origin) -> () ! Errors {
    if count < 0 ||
        count > 2147483647 - pass.sections[pass.current].size ||
        byte_value < -128 ||
        byte_value > 255 {
        return Assembly(failure(origin, "invalid_space_size_or_fill: GNU as §7 Space"))
    }
    if pass.sections[pass.current].kind == 8 {
        if byte_value != 0 {
            return Assembly(failure(origin, "nonzero_nobits_data: ELF gABI Sections"))
        }
        pass.sections[pass.current].size += count
        return
    }
    if count > 67108864 - pass.sections[pass.current].data.len {
        return Assembly(failure(origin, "object_size_limit: ELF gABI Sections"))
    }
    for _ in 0..count { (mut pass.sections[pass.current].data).push(byte_value as byte) }
    pass.sections[pass.current].size += count
}

fn switch_section(mut pass: Pass, node: dialect.Node) -> () ! Errors {
    let name = if node.name == ".section" then node.arguments[0] else node.name
    var flags = if name.starts_with(".text") {
        6
    } else if name.starts_with(".data") || name.starts_with(".bss") {
        3
    } else if name.starts_with(".rodata") {
        2
    } else {
        0
    }
    var kind = if name.starts_with(".bss") then 8 else 1
    if node.name == ".section" && node.arguments.len > 1 {
        let bytes = string_bytes(node.arguments[1]) else {
            return Assembly(failure(node.origin, "bad_section_flags: GNU as §7 Section"))
        }
        flags = 0
        for b in bytes {
            if b == 97 as byte {
                flags |= 2
            } else if b == 119 as byte {
                flags |= 1
            } else if b == 120 as byte {
                flags |= 4
            } else {
                return Assembly(failure(node.origin, "unsupported_section_flag: ELF gABI Sections"))
            }
        }
    }
    if node.name == ".section" && node.arguments.len > 2 {
        kind = match node.arguments[2] {
            "@progbits" => 1,
            "@nobits" => 8,
            "@note" => 7,
            _ => {
                return Assembly(failure(node.origin, "unsupported_section_type: ELF gABI Sections"))
            },
        }
    }
    for i in 0..pass.sections.len {
        if pass.sections[i].name == name {
            if pass.sections[i].flags != flags || pass.sections[i].kind != kind {
                return Assembly(
                    failure(node.origin, "conflicting_section_attributes: GNU as §7 Section"),
                )
            }
            pass.current = i
            return
        }
    }
    pass.current = pass.sections.len
    (mut pass.sections).push(empty_section(name, kind, flags))
    (mut pass.raw_tail).push(false)
    pass.symbols[name] = eval.section_value(name, name, 0)
}

fn patch(mut bytes: List[byte], at: int, width: int, n: eval.Number) {
    var bits = eval.bits(n)
    for i in 0..width {
        bytes[at + i] = (bits & 255) as int as byte
        bits >>= 8
    }
}

fn fixup(
    mut pass: Pass,
    mut bytes: List[byte],
    fix: machine.Fixup,
    globals: Map[str, bool],
    is_call: bool,
    origin: lex.Origin,
    final: bool,
) -> () ! Errors {
    let current = pass.sections[pass.current].name
    let start = pass.sections[pass.current].size
    let v = copy fix.value
    if v.section == "PENDING" {
        if final { return Assembly(failure(origin, "unresolved_expression: GNU as §6")) }
        return
    }
    let global = globals[v.name] else false
    if fix.pcrel && v.section == current && (!global || fix.branch && !is_call) {
        let target = eval.signed(v.number) else {
            return Assembly(failure(origin, "relative_overflow: x86-64 psABI §4.4"))
        }
        let delta = target - start - fix.offset - fix.bias
        if final && !machine.signed_fits(eval.number(delta), fix.width) {
            return Assembly(failure(origin, "relative_overflow: SDM vol.2 branch displacement"))
        }
        patch(mut bytes, fix.offset, fix.width, eval.number(delta))
        return
    }
    if v.section == "ABS" {
        if fix.pcrel {
            return Assembly(failure(origin, "absolute_branch_target: x86-64 psABI §4.4"))
        }
        if !machine.field_fits(v.number, fix.width) {
            return Assembly(failure(origin, "field_overflow: GNU as §6"))
        }
        patch(mut bytes, fix.offset, fix.width, v.number)
        return
    }
    if fix.width != 4 && fix.width != 8 {
        if !final { return }
        return Assembly(failure(origin, "unsupported_narrow_relocation: x86-64 psABI §4.4"))
    }
    var name = v.name
    var addend = signed_bits(v.number)
    if v.section != "UND" {
        if global {
            let base = symbol_value(pass.symbols, name)
            addend -= signed_bits(base.number)
        } else {
            name = v.section
        }
    }
    if fix.pcrel {
        if addend < -9223372036854775807 - 1 + fix.bias {
            return Assembly(failure(origin, "relocation_addend_overflow: x86-64 psABI §4.4"))
        }
        addend -= fix.bias
    }
    if pass.relocations.len == 0 { addend += 1 }
    let kind = if fix.pcrel {
        if fix.branch && (v.section == "UND" || global) then 4 else 2
    } else if fix.width == 8 {
        1
    } else if fix.signed32 {
        11
    } else {
        10
    }
    (mut pass.relocations).push(object.Relocation {
        section: current,
        offset: start + fix.offset,
        kind: kind,
        symbol: name,
        addend: addend,
    })
}

fn data_field(
    mut pass: Pass,
    value: eval.Value,
    width: int,
    globals: Map[str, bool],
    origin: lex.Origin,
    final: bool,
) -> () ! Errors {
    var bytes = List[byte]()
    for _ in 0..width { (mut bytes).push(0 as byte) }
    let fix = machine.Fixup {
        offset: 0,
        width: width,
        pcrel: false,
        branch: false,
        signed32: false,
        value: copy value,
        bias: 0,
    }
    fixup(mut pass, mut bytes, fix, globals, false, origin, final)?
    add_bytes(mut pass, bytes, origin)?
}

fn align_code(mut pass: Pass, count: int, origin: lex.Origin) -> () ! Errors {
    if count > 67108864 - pass.sections[pass.current].data.len {
        return Assembly(failure(origin, "object_size_limit: ELF gABI Sections"))
    }
    var remaining = count
    // Gas 2.42 emits a single-byte NOP after raw-data fragments before its multi-NOP run.
    if remaining > 0 && pass.raw_tail[pass.current] {
        fill(mut pass, 1, 144, origin)?
        remaining -= 1
    }
    // Gas jumps over eight or more maximum-length NOPs; short displacement includes no jump bytes.
    if remaining >= 88 {
        let role = if remaining <= 129 then "relative8" else "relative32"
        let form = x86table.lookup("jmp", role, 0, pass.mode) else {
            return Assembly(failure(origin, "missing_jump_table: SDM JMP"))
        }
        var bytes = List[byte]()
        for b in form.opcode { (mut bytes).push(b as byte) }
        let length = form.opcode.len + form.immediate
        var delta = remaining - length
        for _ in 0..form.immediate { (mut bytes).push((delta & 255) as byte); delta >>= 8 }
        add_bytes(mut pass, bytes, origin)?
        remaining -= length
    }
    while remaining > 0 {
        let n = if remaining > 11 then 11 else remaining
        var bytes = List[byte]()
        if n >= 10 {
            // Pinned gas's redundant-legacy-prefix padding policy; SDM §2.1.1 + NOP Table4-12.
            (mut bytes).push(102 as byte)
            if n == 11 { (mut bytes).push(102 as byte) }
            (mut bytes).push(46 as byte)
            let nop = x86table.padding(8) else {
                return Assembly(failure(origin, "missing_nop_table: SDM Table4-12"))
            }
            for b in nop.bytes { (mut bytes).push(b as byte) }
        } else {
            let nop = x86table.padding(n) else {
                return Assembly(failure(origin, "missing_nop_table: SDM Table4-12"))
            }
            for b in nop.bytes { (mut bytes).push(b as byte) }
        }
        add_bytes(mut pass, bytes, origin)?
        remaining -= n
    }
    if count > 0 { pass.raw_tail[pass.current] = false }
}

fn run_pass(
    prepared: Prepared,
    forms: List[x86table.Form],
    old: Map[str, eval.Value],
    old_lengths: List[int],
    old_selected: List[List[bool]],
    old_dots: List[eval.Value],
    first: bool,
    final: bool,
) -> Pass ! Errors {
    var pass = Pass {
        sections: [
            empty_section(".text", 1, 6),
            empty_section(".data", 1, 3),
            empty_section(".bss", 8, 3),
        ],
        raw_tail: [false, false, false],
        current: 0,
        mode: 64,
        symbols: copy old,
        sizes: Map[str, int](),
        sets: Map[str, bool](),
        set_values: [],
        dots: [],
        lengths: [],
        selected: [],
        relocations: [],
        forms: [],
        ranges: [],
    }
    for name in [".text", ".data", ".bss"] {
        pass.symbols[name] = eval.section_value(name, name, 0)
    }
    for i in 0..prepared.nodes.len {
        let node = copy prepared.nodes[i]
        let section = pass.sections[pass.current].name
        let start = pass.sections[pass.current].size
        let current = pass.current
        let dot = eval.section_value(section, "", start)
        (mut pass.dots).push(copy dot)
        var set_value = eval.absolute(0)
        var selected = List[bool]()
        for label in node.labels { pass.symbols[label] = eval.section_value(section, label, start) }
        if node.kind == "instruction" {
            var values = List[eval.Value]()
            for op in node.operands {
                let v = if op.kind == "register" {
                    eval.absolute(0)
                } else {
                    at_value(pass, prepared, i, op.displacement, old_dots, final)?
                }
                (mut selected).push(v.known)
                (mut values).push(v)
            }
            if !first { selected = copy old_selected[i] }
            var short = false
            if node.name.starts_with("j") &&
                node.name != "ljmp" &&
                node.operands.len == 1 &&
                !node.operands[0].indirect &&
                values[0].section == section {
                let target = eval.signed(values[0].number) else {
                    return Assembly(
                        failure(node.origin, "relative_overflow: SDM branch displacement"),
                    )
                }
                var delta = target - start - 2
                let ordinal = prepared.label_order[values[0].name] else -1
                if ordinal > i && i < old_lengths.len && old_lengths[i] > 2 {
                    delta -= old_lengths[i] - 2
                }
                short = delta >= -128 && delta <= 127
            }
            let form = machine.choose(forms, node, pass.mode, values, selected, short) else |e| {
                return Assembly(
                    failure(node.origin, "{e}: {node.name}; SDM vol.2 instruction encoding table"),
                )
            }
            var encoded = machine.emit(form, node, pass.mode, values, selected) else |e| {
                return Assembly(
                    failure(node.origin, "{e}: SDM vol.{form.volume} {form.section} p.{form.page}"),
                )
            }
            for fix in encoded.fixups {
                fixup(
                    mut pass,
                    mut encoded.data,
                    fix,
                    prepared.globals,
                    form.family == "call",
                    node.origin,
                    final,
                )?
            }
            add_bytes(mut pass, encoded.data, node.origin)?
            pass.raw_tail[pass.current] = false
            (mut pass.forms).push("{node.name}|{form.family}|{form.role}|{form.bits}|{pass.mode}")
        } else if node.kind == "directive" {
            let args = copy node.arguments
            if node.name == ".section" ||
                node.name == ".text" ||
                node.name == ".data" ||
                node.name == ".bss" {
                switch_section(mut pass, node)?
            } else if node.name == ".code32" {
                pass.mode = 32
            } else if node.name == ".code64" {
                pass.mode = 64
            } else if node.name == ".set" {
                if prepared.definitions[args[0]] else false {
                    return Assembly(failure(node.origin, "set_redefines_label: GNU as §7 Set"))
                }
                let v = at_value(pass, prepared, i, args[1], old_dots, final)?
                set_value = copy v
                var stored = copy v
                if v.section != "UND" && v.section != "PENDING" { stored.name = args[0] }
                pass.symbols[args[0]] = stored
                pass.sets[args[0]] = true
            } else if node.name == ".size" {
                let v = at_value(pass, prepared, i, args[1], old_dots, final)?
                let size = integer(v, node.origin, final)?
                if size < 0 {
                    return Assembly(
                        failure(node.origin, "negative_symbol_size: ELF gABI Symbol Table"),
                    )
                }
                pass.sizes[args[0]] = size
            } else if node.name == ".ascii" || node.name == ".asciz" {
                for arg in args {
                    let bytes = string_bytes(arg) else {
                        return Assembly(failure(node.origin, "bad_string_escape: GNU as §3.6.1"))
                    }
                    add_bytes(mut pass, bytes, node.origin)?
                    if node.name == ".asciz" { fill(mut pass, 1, 0, node.origin)? }
                }
                pass.raw_tail[pass.current] = true
            } else if node.name == ".byte" ||
                node.name == ".word" ||
                node.name == ".long" ||
                node.name == ".quad" {
                let width = match node.name {
                    ".byte" => 1,
                    ".word" => 2,
                    ".long" => 4,
                    _ => 8,
                }
                for arg in args {
                    let v = at_value(pass, prepared, i, arg, old_dots, final)?
                    data_field(mut pass, v, width, prepared.globals, node.origin, final)?
                }
                pass.raw_tail[pass.current] = true
            } else if node.name == ".zero" || node.name == ".space" {
                let count = integer(
                    at_value(pass, prepared, i, args[0], old_dots, final)?,
                    node.origin,
                    final,
                )?
                let byte_value = if args.len > 1 {
                    integer(
                        at_value(pass, prepared, i, args[1], old_dots, final)?,
                        node.origin,
                        final,
                    )?
                } else {
                    0
                }
                fill(mut pass, count, byte_value, node.origin)?
                if count > 0 { pass.raw_tail[pass.current] = true }
            } else if node.name == ".p2align" || node.name == ".balign" {
                let value = integer(
                    at_value(pass, prepared, i, args[0], old_dots, final)?,
                    node.origin,
                    final,
                )?
                if value < 0 || value > 1073741824 || node.name == ".p2align" && value > 30 {
                    return Assembly(failure(node.origin, "invalid_alignment: GNU as §7 Align"))
                }
                let alignment: int = if node.name == ".p2align" {
                    1 << value
                } else if value == 0 {
                    1
                } else {
                    value
                }
                if alignment & alignment - 1 != 0 {
                    return Assembly(
                        failure(node.origin, "non_power_of_two_alignment: ELF gABI Sections"),
                    )
                }
                if alignment > pass.sections[pass.current].align {
                    pass.sections[pass.current].align = alignment
                }
                var count = (alignment - start % alignment) % alignment
                if args.len > 2 && args[2].len > 0 {
                    let maxskip = integer(
                        at_value(pass, prepared, i, args[2], old_dots, final)?,
                        node.origin,
                        final,
                    )?
                    if maxskip < 0 {
                        return Assembly(
                            failure(node.origin, "negative_alignment_maxskip: GNU as §7 Align"),
                        )
                    }
                    if count > maxskip { count = 0 }
                }
                if args.len > 1 && args[1].len > 0 {
                    let byte_value = integer(
                        at_value(pass, prepared, i, args[1], old_dots, final)?,
                        node.origin,
                        final,
                    )?
                    fill(mut pass, count, byte_value, node.origin)?
                    if count > 0 { pass.raw_tail[pass.current] = true }
                } else if pass.sections[pass.current].flags & 4 != 0 {
                    align_code(mut pass, count, node.origin)?
                } else {
                    fill(mut pass, count, 0, node.origin)?
                }
            } else if node.name != ".globl" && node.name != ".type" {
                return Assembly(failure(node.origin, "unknown_directive {node.name}: GNU as §7"))
            }
        }
        let length = if pass.current == current then pass.sections[current].size - start else 0
        (mut pass.lengths).push(length)
        (mut pass.selected).push(selected)
        (mut pass.set_values).push(set_value)
        if length > 0 && pass.sections[current].kind != 8 {
            (mut pass.ranges).push(Range {
                section: section,
                offset: start,
                size: length,
                origin: copy node.origin,
            })
        }
    }
    if final {
        for name in prepared.names {
            if !(pass.sets[name] else false) { continue }
            let value = symbol_value(pass.symbols, name)
            if value.section == "UND" && (pass.sets[value.name] else false) {
                return Assembly(
                    failure(
                        lex.Origin { file: "<symbols>", line: 0, chain: "" },
                        "cyclic_set {name}: GNU as §7 Set",
                    ),
                )
            }
        }
    }
    pass
}

fn same_layout(a: Pass, b: Pass, names: List[str]) -> bool {
    if a.sections.len != b.sections.len || a.lengths.len != b.lengths.len { return false }
    for i in 0..a.sections.len {
        if a.sections[i].size != b.sections[i].size || a.sections[i].align != b.sections[i].align {
            return false
        }
    }
    for i in 0..a.lengths.len { if a.lengths[i] != b.lengths[i] { return false } }
    for name in names {
        let x = symbol_value(a.symbols, name)
        let y = symbol_value(b.symbols, name)
        if x.section != y.section ||
            x.name != y.name ||
            x.known != y.known ||
            x.number.magnitude != y.number.magnitude ||
            x.number.negative != y.number.negative {
            return false
        }
    }
    true
}

fn output_symbols(prepared: Prepared, pass: Pass) -> List[object.Symbol] {
    var used = Map[str, bool]()
    for r in pass.relocations { used[r.symbol] = true }
    var out = List[object.Symbol]()
    var section_names = Map[str, bool]()
    for section in pass.sections {
        section_names[section.name] = true
        if used[section.name] else false {
            (mut out).push(object.Symbol {
                name: section.name,
                binding: 0,
                kind: 3,
                section: section.name,
                value: 0,
                size: 0,
                visibility: 0,
            })
        }
    }
    for name in prepared.names {
        if section_names[name] else false { continue }
        let v = symbol_value(pass.symbols, name)
        let global = prepared.globals[name] else false
        let referenced = used[name] else false
        if v.section == "UND" && !global && !referenced { continue }
        if name.starts_with(".L") && !global && !referenced { continue }
        let binding = if global || v.section == "UND" then 1 else 0
        (mut out).push(object.Symbol {
            name: name,
            binding: binding,
            kind: prepared.kinds[name] else 0,
            section: v.section,
            value: if v.section == "UND" then 0 else signed_bits(v.number),
            size: pass.sizes[name] else 0,
            visibility: 0,
        })
    }
    out
}

fn expanded(prepared: Prepared, pass: Pass) -> List[str] {
    var lines = List[str]()
    for i in 0..prepared.rows.len {
        (mut lines).push(expand.origin_comment(prepared.rows[i].origin))
        if prepared.nodes[i].name == ".set" {
            let v = copy pass.set_values[i]
            let name = prepared.nodes[i].arguments[0]
            let value = if v.section == "ABS" {
                eval.spelling(v.number)
            } else if v.section == "UND" {
                "{v.name}+({eval.spelling(v.number)})"
            } else {
                "{v.section}+({eval.spelling(v.number)})"
            }
            (mut lines).push(".set {name}, {value}")
        } else {
            (mut lines).push(prepared.rows[i].text)
        }
    }
    lines
}

/// Assemble to a deterministic relocatable object after convergent layout and a final strict pass.
pub fn assemble_options(text: str, file: str, with_provenance: bool) -> Result ! Errors {
    let prepared = prepare(text, file)?
    let forms = x86table.load_all() else {
        return Assembly(
            failure(
                lex.Origin { file: file, line: 0, chain: "" },
                "invalid_encoding_table: SDM vol.2",
            ),
        )
    }
    var previous = run_pass(prepared, forms, Map[str, eval.Value](), [], [], [], true, false)?
    var count = 1
    var stable = false
    while count < 64 {
        var next = run_pass(
            prepared,
            forms,
            previous.symbols,
            previous.lengths,
            previous.selected,
            previous.dots,
            false,
            false,
        )?
        count += 1
        stable = same_layout(previous, next, prepared.names)
        previous = next
        if stable { break }
    }
    if !stable {
        return Assembly(
            failure(
                lex.Origin { file: file, line: 0, chain: "" },
                "layout_nonconvergent: GNU as Expressions and alignment policy",
            ),
        )
    }
    var final = run_pass(
        prepared,
        forms,
        previous.symbols,
        previous.lengths,
        previous.selected,
        previous.dots,
        false,
        true,
    )?
    let symbols = output_symbols(prepared, final)
    if with_provenance { (mut final.sections).push(provenance(final.ranges)) }
    let bytes = object.write(final.sections, symbols, final.relocations) else {
        return Assembly(
            failure(lex.Origin { file: file, line: 0, chain: "" }, "invalid_object: ELF gABI §4"),
        )
    }
    Result {
        bytes: bytes,
        expanded: expanded(prepared, final),
        forms: copy final.forms,
        passes: count + 1,
    }
}

/// Assemble with provenance off, preserving the exact-gas comparison boundary.
pub fn assemble(text: str, file: str) -> Result ! Errors {
    assemble_options(text, file, false)?
}

fn set_version(prepared: Prepared, name: str, at: int) -> int {
    var prior = -1
    var forward = -1
    for i in 0..prepared.nodes.len {
        if prepared.nodes[i].name != ".set" || prepared.nodes[i].arguments[0] != name { continue }
        if i < at { prior = i } else if forward < 0 { forward = i }
    }
    if prior >= 0 then prior else forward
}

fn version_value(
    prepared: Prepared,
    index: int,
    use_at: int,
    symbols: Map[str, eval.Value],
    dots: List[eval.Value],
    old_dots: List[eval.Value],
    final: bool,
    depth: int,
) -> eval.Value ! Errors {
    let node = copy prepared.nodes[index]
    if depth > 256 { return Assembly(failure(node.origin, "set_dependency_depth: GNU as §7 Set")) }
    let dot = if index < dots.len {
        copy dots[index]
    } else if index < old_dots.len {
        copy old_dots[index]
    } else {
        eval.Value { number: eval.number(0), section: "PENDING", name: ".", known: false }
    }
    if dot.section == "PENDING" && node.arguments[1].contains(".") {
        return eval.Value {
            number: eval.number(0),
            section: "PENDING",
            name: node.arguments[1],
            known: false,
        }
    }
    var context = copy symbols
    for name in names_in(node.arguments[1]) {
        let version = set_version(prepared, name, index)
        if version >= 0 {
            context[name] = version_value(
                prepared,
                version,
                use_at,
                symbols,
                dots,
                old_dots,
                final,
                depth + 1,
            )?
        }
    }
    var value = evaluate(node.arguments[1], context, dot, node.origin, final)?
    value.known = value.known && index <= use_at
    if value.section != "UND" && value.section != "PENDING" { value.name = node.arguments[0] }
    value
}

fn at_value(
    pass: Pass,
    prepared: Prepared,
    ordinal: int,
    text: str,
    old_dots: List[eval.Value],
    final: bool,
) -> eval.Value ! Errors {
    var context = copy pass.symbols
    for name in names_in(text) {
        let version = set_version(prepared, name, ordinal)
        if version >= 0 {
            context[name] = version_value(
                prepared,
                version,
                ordinal,
                pass.symbols,
                pass.dots,
                old_dots,
                final,
                0,
            )?
        }
    }
    let dot = eval.section_value(
        pass.sections[pass.current].name,
        "",
        pass.sections[pass.current].size,
    )
    evaluate(text, context, dot, prepared.nodes[ordinal].origin, final)?
}
