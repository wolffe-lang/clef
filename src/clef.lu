//! member: false

use assembly
use decode
use front
use x86table

fn main() -> int {
    let args = env_args()
    if args.len == 1 && args[0] == "--version" {
        print("clef 0.0.0 (GNU-as AT&T x86-64 census dialect)")
        return 0
    }
    let opts = front.parse(args) else |_| {
        eprint(
            "clef: usage: clef [--64] [-c] [--target=x86_64-unknown-none-elf] FILE.S [-o FILE.o] [--provenance]; clef --expand FILE.S; clef --disassemble [--raw --address=N] [--code32] [--roundtrip] [--expand] FILE",
        )
        return 2
    }
    let bytes = fs_read_bytes(opts.input) else |_| {
        eprint("clef: cannot read {opts.input}")
        return 1
    }
    if opts.disassemble { return disassemble(opts, bytes) }
    let text = str_from_utf8(bytes) else |_| { eprint("clef: source is not UTF-8"); return 1 }
    let result = assembly.assemble_options(text, opts.input, opts.provenance) else |e| {
        eprint("clef: {e}")
        return 1
    }
    if opts.expand {
        for line in result.expanded { print(line) }
        return 0
    }
    let fd = fs_open_mode(opts.output, 1) else |_| {
        eprint("clef: cannot create {opts.output}")
        return 1
    }
    defer fs_close(fd) else |_| {}
    fs_write_chunk(fd, result.bytes) else |_| {
        eprint("clef: cannot write {opts.output}")
        return 1
    }
    0
}

/// Buffered stdout: one write per 64 KiB, never one per line.
struct Out {
    fd: int,
    buf: List[byte],
}

fn flush(mut o: Out) -> () ! {io} {
    fs_write_chunk(o.fd, o.buf) else { return io }
    o.buf = List[byte]()
}

fn emit(mut o: Out, s: str) -> () ! {io} {
    for b in s.bytes() { (mut o.buf).push(b) }
    (mut o.buf).push(10 as byte)
    if o.buf.len >= 65536 { flush(mut o)? }
}

/// `--disassemble`: every executable section of an ELF file, or a raw stream, as objdump's
/// text, as round-trip source, or with the field view.
fn disassemble(opts: front.Options, bytes: List[byte]) -> int {
    let forms = x86table.load_all() else {
        eprint("clef: the encoding table does not load")
        return 1
    }
    let idx = decode.index(forms)
    var sections = List[decode.Code]()
    if opts.raw {
        (mut sections).push(decode.Code { name: ".raw", address: opts.address, bytes: copy bytes })
    } else {
        sections = decode.executable_sections(bytes) else |e| {
            eprint("clef: {opts.input}: {e}")
            return 1
        }
    }
    let mode = if opts.code32 then 32 else 64
    var o = Out {
        fd: fs_open_mode("/dev/stdout", 2) else {
            eprint("clef: cannot open standard output")
            return 1
        },
        buf: [],
    }
    for s in sections {
        if opts.roundtrip {
            emit(mut o, "# section {s.name} at {s.address}") else { return 1 }
        } else {
            emit(mut o, "") else { return 1 }
            emit(mut o, "Disassembly of section {s.name}:") else { return 1 }
            emit(mut o, "") else { return 1 }
        }
        var at = 0
        while at < s.bytes.len {
            region one {
                let d = decode.decode(idx, s.bytes, at, mode, s.address)
                if opts.roundtrip {
                    emit(mut o, decode.roundtrip(idx, s.bytes, d, mode)) else { return 1 }
                } else {
                    emit(mut o, decode.text(d, s.address)) else { return 1 }
                    if opts.expand {
                        for line in decode.expand(idx, d) { emit(mut o, line) else { return 1 } }
                    }
                }
                at += if d.length > 0 then d.length else 1
            }
        }
    }
    flush(mut o) else { return 1 }
    0
}
