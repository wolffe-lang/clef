// A reader for the executable sections of an ELF64 little-endian x86-64 file (ELF gABI ch.4:
// the ELF header, section headers and the section-name string table). Nothing else of the
// file is interpreted: the disassembler reads bytes, addresses and names.

/// One executable section: its name, load address and contents.
pub struct Code {
    name: str,
    address: int,
    bytes: List[byte],
}

/// not_elf64_x86_64: the magic, class, data or machine is not ELF64 LE x86-64;
/// malformed_elf: a header, table or string points outside the file.
pub error ElfErrors = {not_elf64_x86_64, malformed_elf}

fn read16(d: List[byte], at: int) -> int ! ElfErrors {
    if at + 2 > d.len { return malformed_elf }
    d[at] as int + d[at + 1] as int * 256
}

fn read32(d: List[byte], at: int) -> int ! ElfErrors {
    if at + 4 > d.len { return malformed_elf }
    var v = 0
    for i in 0..4 { v += d[at + i] as int << 8 * i }
    v
}

fn read64(d: List[byte], at: int) -> int ! ElfErrors {
    if at + 8 > d.len { return malformed_elf }
    // The top byte may carry the sign: a kernel's addresses live above 2^63 and are kept in
    // two's complement, as the decoder's --address takes them.
    var v = 0
    for i in 0..7 { v += d[at + i] as int << 8 * i }
    let top = d[at + 7] as int
    v + (if top >= 128 then top - 256 else top) << 56
}

fn name_at(table: List[byte], at: int) -> str ! ElfErrors {
    var end = at
    while end < table.len && table[end] != 0 as byte { end += 1 }
    if end >= table.len { return malformed_elf }
    var bytes = List[byte]()
    for i in at..end { (mut bytes).push(table[i]) }
    str_from_utf8(bytes) else { return malformed_elf }
}

/// Every SHF_EXECINSTR section with file contents (not SHT_NOBITS), in header order.
pub fn executable_sections(d: List[byte]) -> List[Code] ! ElfErrors {
    if d.len < 64 ||
        d[0] != 127 as byte ||
        d[1] != 69 as byte ||
        d[2] != 76 as byte ||
        d[3] != 70 as byte {
        return not_elf64_x86_64
    }
    if d[4] != 2 as byte || d[5] != 1 as byte || read16(d, 18)? != 62 { return not_elf64_x86_64 }
    let shoff = read64(d, 40)?
    let shentsize = read16(d, 58)?
    let shnum = read16(d, 60)?
    let shstrndx = read16(d, 62)?
    if shentsize != 64 || shnum == 0 || shstrndx >= shnum { return malformed_elf }
    let names_header = shoff + shstrndx * 64
    let names_offset = read64(d, names_header + 24)?
    let names_size = read64(d, names_header + 32)?
    if names_offset + names_size > d.len { return malformed_elf }
    var table = List[byte]()
    for i in names_offset..names_offset + names_size { (mut table).push(d[i]) }
    var out = List[Code]()
    for i in 0..shnum {
        let h = shoff + i * 64
        let name_index = read32(d, h)?
        let kind = read32(d, h + 4)?
        let flags = read64(d, h + 8)?
        let address = read64(d, h + 16)?
        let offset = read64(d, h + 24)?
        let size = read64(d, h + 32)?
        if flags / 4 % 2 != 1 || kind == 8 || size == 0 { continue }
        if offset + size > d.len { return malformed_elf }
        var bytes = List[byte]()
        for j in offset..offset + size { (mut bytes).push(d[j]) }
        (mut out).push(Code { name: name_at(table, name_index)?, address: address, bytes: bytes })
    }
    out
}
