    ]
    let sources = ["pax.text[5450:10990] at 0xffffffff8000154a"]
    let bases = [-2147478198]
    for i in 0..modes.len {
        n += 1
        let mode_text = modes[i]
        let hex_text = hexes[i]
        let expected = expecteds[i]
        let source = sources[i]
        let base = bases[i]
        let mode = mode_text.to_int() else 64
        let bytes = hexbytes(hex_text)
        var at = 0
        var text = ""
        var rt = ""
        var lines = 0
        while at < bytes.len {
            let d = decode.decode(idx, bytes, at, mode, base)
            let line = decode.text(d, base)
            let colon = line.find(":\t") else 0
            text += (if text.len == 0 then "" else "§") + canon(line[colon + 2..])
            let r = decode.roundtrip(idx, bytes, d, mode)
            if r.contains(".byte") { escaped += 1; print("ESCAPED {source} | {r}") }
            rt += r
            lines += 1
            at += if d.length > 0 then d.length else 1
        }
        if text != expected {
            red += 1
            if expected.len < 400 {
                print("RED {source} | od: {expected} | clef: {text}")
            } else {
                print("RED {source}: {lines} lines decoded; texts differ")
                let a = expected.split("\n")
                let b = text.split("\n")
                var shown = 0
                var k = 0
                while k < a.len && k < b.len && shown < 12 {
                    if a[k] != b[k] { shown += 1; print("  od: {a[k]}   clef: {b[k]}") }
                    k += 1
                }
                print("  lines: od {a.len}, clef {b.len}")
            }
        }
    }
    print("witnesses: {n} rows, {red} text red, {escaped} round-trip escapes")
    0
}
