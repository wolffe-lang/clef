//! member: false

use decode
use x86table

fn canon(s: str) -> str {
    var out = ""
    var space = false
    var i = 0
    while i < s.len {
        let c = s.bytes()[i] as int
        if c == 9 || c == 32 { space = true } else {
            if space && out.len > 0 { out += " " }
            space = false
            out += s[i..i + 1]
        }
        i += 1
    }
    out
}

fn hexbytes(h: str) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i + 1 < h.len {
        let a = digit(h.bytes()[i] as int)
        let b = digit(h.bytes()[i + 1] as int)
        (mut out).push((a * 16 + b) as byte)
        i += 2
    }
    out
}

fn digit(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    0
}

