/// Assembler-shaped and assembly-only C-driver-shaped invocations.
pub struct Options {
    input: str,
    output: str,
    expand: bool,
    provenance: bool,
    disassemble: bool,
    raw: bool,
    address: int,
    code32: bool,
    roundtrip: bool,
}

/// `--address=N`: decimal or 0x-hexadecimal load address of a raw byte stream.
fn parse_address(text: str) -> int ! {usage} {
    if text.starts_with("0x") || text.starts_with("0X") {
        // A 64-bit address above 2^63 (the kernel's half) is held as its two's complement.
        var v: u64 = 0
        if text.len == 2 || text.len > 18 { return usage }
        for b in text[2..].bytes() {
            let c = b as int
            let digit = if c >= 48 && c <= 57 {
                c - 48
            } else if c >= 97 && c <= 102 {
                c - 87
            } else if c >= 65 && c <= 70 {
                c - 55
            } else {
                return usage
            }
            v = v * 16 + digit as u64
        }
        if v >= 9223372036854775808 { return -((!v + 1) as int) }
        return v as int
    }
    text.to_int() else { return usage }
}

/// Accept one .S/.s source, --64, -c, -o, the freestanding target, and explicit inspection options.
/// usage refuses unknown options, nonassembly inputs, conflicts, and missing/duplicate operands.
pub fn parse(args: List[str]) -> Options ! {usage} {
    var input = ""
    var output = "a.out"
    var output_seen = false
    var compile = false
    var target = false
    var expand = false
    var provenance = false
    var disassemble = false
    var raw = false
    var address = 0
    var code32 = false
    var roundtrip = false
    var i = 0
    while i < args.len {
        let a = args[i]
        if a == "-o" {
            if output_seen { return usage }
            output_seen = true
            i += 1
            if i >= args.len || args[i].len == 0 || args[i].starts_with("-") { return usage }
            output = args[i]
        } else if a == "--expand" {
            expand = true
        } else if a == "--provenance" {
            provenance = true
        } else if a == "--disassemble" {
            disassemble = true
        } else if a == "--raw" {
            raw = true
        } else if a == "--code32" {
            code32 = true
        } else if a == "--roundtrip" {
            roundtrip = true
        } else if a.starts_with("--address=") {
            address = parse_address(a[10..])?
        } else if a == "-c" {
            compile = true
        } else if a == "--target=x86_64-unknown-none-elf" {
            target = true
        } else if a == "--64" {} else if a.starts_with("-") || input.len != 0 {
            return usage
        } else {
            input = a
        }
        i += 1
    }
    if disassemble {
        // The disassembler reads any file; nothing is written but the text.
        if input.len == 0 || output_seen || provenance || compile || target { return usage }
        return Options {
            input: input,
            output: output,
            expand: expand,
            provenance: false,
            disassemble: true,
            raw: raw,
            address: address,
            code32: code32,
            roundtrip: roundtrip,
        }
    }
    if raw || code32 || roundtrip || address != 0 { return usage }
    if input.len == 0 ||
        input == output ||
        !input.ends_with(".S") && !input.ends_with(".s") ||
        target && !compile ||
        expand && (output_seen || provenance) {
        return usage
    }
    Options {
        input: input,
        output: output,
        expand: expand,
        provenance: provenance,
        disassemble: false,
        raw: false,
        address: 0,
        code32: false,
        roundtrip: false,
    }
}
