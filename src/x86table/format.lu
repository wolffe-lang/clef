// Intel SDM 325383-086US (December 2024), independently transcribed.
// The table describes encodings, not host CPU availability or execution safety.
// Prefix is COMPLETE operand-size/mandatory prefix: never infer 66 from bits.
// REX.R/X/B are computed from operand roles; rex_w is the separate W policy.
// Operand indices are AT&T order. -1 denotes an unused encoding field, not an error.

/// A reusable encoding row; guards and operand patterns must be checked before emission.
pub struct Form {
    family: str,
    role: str,
    bits: int,
    modes: str,
    opcode: List[int],
    extension: int,
    prefix: int,
    rex_w: bool,
    immediate: int,
    reg_operand: int,
    rm_operand: int,
    opcode_operand: int,
    immediate_operand: int,
    guard: str,
    preference: str,
    feature: str,
    volume: str,
    section: str,
    page: str,
    citation: str,
    operands: str,
    immediate_kind: str,
    allowed_prefixes: str,
}

/// Encoding lookup errors never produce a fallback instruction.
pub error TableErrors = {unknown_form, invalid_table}

/// Parse one provenance-first row; all integer columns are decimal.
pub fn load(line: str) -> Form ! {invalid_table} {
    let f = line.split("|")
    if f.len != 23 { return invalid_table }
    for i in [0, 1, 2, 3, 4, 5, 7, 17, 18, 19, 20, 21, 22] {
        if f[i].len == 0 { return invalid_table }
    }
    let bits = f[6].to_int() else { return invalid_table }
    let extension = f[9].to_int() else { return invalid_table }
    let prefix = f[10].to_int() else { return invalid_table }
    let rex = f[11].to_int() else { return invalid_table }
    let immediate = f[12].to_int() else { return invalid_table }
    let reg = f[13].to_int() else { return invalid_table }
    let rm = f[14].to_int() else { return invalid_table }
    let opreg = f[15].to_int() else { return invalid_table }
    let immop = f[16].to_int() else { return invalid_table }
    if bits != 0 && bits != 8 && bits != 16 && bits != 32 && bits != 64 && bits != 128 {
        return invalid_table
    }
    if f[7] != "32" && f[7] != "64" && f[7] != "32,64" { return invalid_table }
    if extension < -1 ||
        extension > 7 ||
        rex < 0 ||
        rex > 1 ||
        prefix != 0 && prefix != 102 && prefix != 242 && prefix != 243 ||
        immediate < 0 ||
        immediate > 8 {
        return invalid_table
    }
    if rex == 1 && f[7] != "64" { return invalid_table }
    for index in [reg, rm, opreg, immop] {
        if index < -1 || index > 2 { return invalid_table }
    }
    if reg >= 0 && extension >= 0 ||
        rm < 0 && (reg >= 0 || extension >= 0) ||
        opreg >= 0 && rm >= 0 ||
        immediate == 0 && immop >= 0 ||
        immediate > 0 && immop < 0 {
        return invalid_table
    }
    var opcode = List[int]()
    for text in f[8].split(",") {
        let n = text.to_int() else { return invalid_table }
        if n < 0 || n > 255 { return invalid_table }
        (mut opcode).push(n)
    }
    if opcode.len < 1 || opcode.len > 3 { return invalid_table }
    Form {
        family: f[4],
        role: f[5],
        bits: bits,
        modes: f[7],
        opcode: opcode,
        extension: extension,
        prefix: prefix,
        rex_w: rex == 1,
        immediate: immediate,
        reg_operand: reg,
        rm_operand: rm,
        opcode_operand: opreg,
        immediate_operand: immop,
        guard: f[17],
        preference: f[18],
        feature: f[19],
        volume: f[0],
        section: f[1],
        page: f[2],
        citation: f[3],
        operands: f[20],
        immediate_kind: f[21],
        allowed_prefixes: f[22],
    }
}

/// Exact role/width lookup; this does not validate an instruction's operands.
pub fn lookup(family: str, role: str, bits: int, mode: int) -> Form ! TableErrors {
    if mode != 32 && mode != 64 { return unknown_form }
    for text in source() {
        let form = load(text)?
        if form.family != family || form.role != role || form.bits != bits { continue }
        for m in form.modes.split(",") {
            if m == "{mode}" { return form }
        }
    }
    unknown_form
}

/// Shared field provenance applies in addition to every instruction-specific citation.
pub fn field_sources() -> List[str] {
    [
        "2A|2.1.1|2-1..2-2|F0 LOCK; F3 REP; 66 operand-size; 67 address-size; one per legacy group",
        "2A|2.1.5|2-3..2-6|Tables 2-2 and 2-3: ModRM and SIB; displacement fields",
        "2A|2.2.1|2-7..2-11|REX must immediately precede opcode; Table 2-4 0100WRXB; Table 2-5 special base/index cases",
        "2A|2.2.1.2|2-9..2-11|REX.R=ModRM reg; X=SIB index; B=rm/base/opcode register; high8 unavailable with REX",
        "2A|2.2.1.3..2.2.1.7|2-11..2-12|displacement sign extension; moffs follows address-size; RIP-relative mod00 rm101; near/stack default64",
        "2B|4.3 REP/REPE/REPZ/REPNE/REPNZ|4-562..4-563|F3 MOVS/STOS; repeat prefix before REX",
    ]
}

/// Parse once per assembly; keep this list outside iterative layout passes.
pub fn load_all() -> List[Form] ! {invalid_table} {
    var forms = List[Form]()
    for text in source() {
        let form = load(text)?
        (mut forms).push(form)
    }
    forms
}

/// Search cached rows and copy only the matched descriptor, including its opcode list.
pub fn lookup_in(forms: List[Form], family: str, role: str, bits: int, mode: int) -> Form ! {
    unknown_form,
} {
    if mode != 32 && mode != 64 { return unknown_form }
    for form in forms {
        if form.family == family &&
            form.role == role &&
            form.bits == bits &&
            (
                form.modes == "32,64" ||
                    mode == 32 && form.modes == "32" ||
                    mode == 64 && form.modes == "64"
            ) {
            return copy form
        }
    }
    unknown_form
}
