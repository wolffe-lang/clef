/// Preserve the alias's role/source width when selecting extending moves.
pub fn alias(mnemonic: str) -> Alias ! {unknown_form} {
    for a in aliases() {
        if a.spelling == mnemonic { return a }
    }
    unknown_form
}

/// Normalize an explicit spelling without silently accepting an unknown suffix.
pub fn canonical(mnemonic: str) -> (str, int) ! {unknown_form} {
    let a = alias(mnemonic)?
    (a.family, a.bits)
}
